# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE_MAPS_API_KEY: Dedicated browser key returned only to an authenticated picker.
# It is still visible to that browser by design. Do not reuse a server or Firebase key.
# Restrict it to approved website origins and only the Maps JavaScript API.
GOOGLE_MAPS_API_KEY="MY_RESTRICTED_GOOGLE_MAPS_BROWSER_KEY"

# GOOGLE_MAPS_MAP_ID: Production JavaScript map ID associated with this app.
GOOGLE_MAPS_MAP_ID="MY_GOOGLE_MAPS_MAP_ID"

# OWNER_UIDS: Comma-separated Firebase UIDs allowed to exercise owner-only RBAC gates.
# Owner claims are bootstrapped out of band; the app cannot create new owners.
OWNER_UIDS="FIREBASE_OWNER_UID"

# One-time owner bootstrap. Never expose these values to the browser.
BOOTSTRAP_OWNER_UID="FIREBASE_OWNER_UID"
BOOTSTRAP_OWNER_CONFIRMATION="BOOTSTRAP OWNER"

# Server-side role command inputs. Use a unique idempotency key for each approved change.
ROLE_OPERATOR_UID="FIREBASE_OWNER_UID"
ROLE_TARGET_UID="TARGET_FIREBASE_UID"
ROLE_REQUESTED_ROLE="admin"
ROLE_CHANGE_REASON="Documented operational reason"
ROLE_CHANGE_CONFIRMATION="GRANT ADMIN"
ROLE_CHANGE_IDEMPOTENCY_KEY="UNIQUE_ROLE_CHANGE_ID_AT_LEAST_16_CHARS"

# FIRESTORE_DATABASE_ID: Explicit named database used by server-only audit and delivery records.
FIRESTORE_DATABASE_ID="ai-studio-d82d6296-0049-4433-955f-91f203831d05"

# External notification credentials are server-side secrets only.
# Slack and Discord use app-owned incoming webhooks. Never place these URLs in Firestore or client code.
SLACK_WEBHOOK_URL="MY_SLACK_WEBHOOK_SECRET"
DISCORD_WEBHOOK_URL="MY_DISCORD_WEBHOOK_SECRET"

# Gmail API OAuth 2.0 credentials. Request only gmail.send and offline access.
# Store the client secret and refresh token in Secret Manager; never use a Gmail password or App Password.
GMAIL_CLIENT_ID="MY_GOOGLE_OAUTH_CLIENT_ID"
GMAIL_CLIENT_SECRET="MY_GOOGLE_OAUTH_CLIENT_SECRET"
GMAIL_REFRESH_TOKEN="MY_GOOGLE_OAUTH_REFRESH_TOKEN"
GMAIL_SENDER_EMAIL="notifications@example.com"
